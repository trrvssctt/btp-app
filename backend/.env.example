# Modèle de backend/.env — copier en backend/.env et renseigner les valeurs.
# Le vrai fichier .env n'est jamais versionné (voir .gitignore).

PORT=3000
NODE_ENV=production

# PostgreSQL
DATABASE_URL="postgres://UTILISATEUR:MOT_DE_PASSE@HOTE:5432/BASE"
PGHOST=
PGPORT=5432
PGUSER=
PGDATABASE=
PGPASSWORD=
# PGSSL_REJECT_UNAUTHORIZED=false

# JWT — chaîne longue et aléatoire (ex. : openssl rand -hex 48)
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Origines autorisées, séparées par une virgule (ex. http://185.215.165.43:2000)
CORS_ORIGINS=

# Cloudinary — stockage des images (logo entreprise)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
